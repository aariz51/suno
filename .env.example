# Optional. Without it Suno runs entirely on its deterministic rule table and
# labels every answer accordingly on screen — that is the documented fallback,
# not a degraded mode. See README.md.
OPENAI_API_KEY=

# Optional. Points the OpenAI SDK at a different endpoint — used by
# scripts/model-path.test.mjs to drive the real route against a local stub,
# and available for an enterprise proxy.
OPENAI_BASE_URL=
